* text=auto eol=lf

# Preserve the exact upstream notice bytes; readable notices are generated separately.
resources/licenses/rust/texts/*.txt binary
resources/licenses/native/texts/*.txt binary
resources/licenses/toolchain/texts/*.txt binary
*.crate binary
*.tgz binary
*.wasm binary
resources/licenses/shader-preprocessor/** -text whitespace=-blank-at-eol,-blank-at-eof
resources/icons/*/LICENSE binary
resources/fonts/OFL.txt binary
resources/licenses/MPL-2.0.txt binary
# Preserve upstream source and generated notice formatting without rewriting it.
vendor/skia-bindings/** whitespace=-blank-at-eol,-blank-at-eof
resources/licenses/rust/RUST-NOTICES.txt whitespace=-blank-at-eof
*.ttf binary
*.otf binary
*.ttc binary
*.otc binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
