{
  "version": "2.21",
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "name": "Browser and shader example",
      "width": 1000,
      "height": 640,
      "layout": "vertical",
      "padding": 32,
      "gap": 20,
      "fill": "#F8FAFC",
      "children": [
        {
          "id": "title",
          "type": "text",
          "content": "Web ページと GLSL を一つのデザインへ",
          "fontFamily": "Noto Sans JP",
          "fontSize": 30,
          "fontWeight": "700",
          "fill": "#0F172A"
        },
        {
          "id": "description",
          "type": "text",
          "content": "通常の文字とレイアウトは Skia、動的な内容は別途導入したランタイムで描きます。",
          "fontFamily": "Noto Sans JP",
          "fontSize": 16,
          "fontWeight": "400",
          "fill": "#475569"
        },
        {
          "id": "row",
          "type": "frame",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "horizontal",
          "gap": 20,
          "children": [
            {
              "id": "web-card",
              "type": "frame",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "padding": 16,
              "gap": 16,
              "cornerRadius": 16,
              "fill": "#FFFFFF",
              "children": [
                {
                  "id": "web-card-title",
                  "type": "text",
                  "content": "ページのスナップショット",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 18,
                  "fontWeight": "700",
                  "fill": "#0F172A"
                },
                {
                  "id": "web",
                  "type": "browser",
                  "width": "fill_container",
                  "height": "fill_container",
                  "cornerRadius": 8,
                  "url": "data:text/html;base64,"
                },
                {
                  "id": "web-card-caption",
                  "type": "text",
                  "content": "独自の HTML を使用した、オフラインの作例",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fontWeight": "400",
                  "fill": "#64748B"
                }
              ]
            },
            {
              "id": "shader-card",
              "type": "frame",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "padding": 16,
              "gap": 16,
              "cornerRadius": 16,
              "fill": "#FFFFFF",
              "children": [
                {
                  "id": "shader-card-title",
                  "type": "text",
                  "content": "ソフトウェア WebGL",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 18,
                  "fontWeight": "700",
                  "fill": "#0F172A"
                },
                {
                  "id": "waves",
                  "type": "rectangle",
                  "width": "fill_container",
                  "height": "fill_container",
                  "cornerRadius": 8,
                  "fill": {
                    "type": "shader",
                    "url": "assets/waves.glsl",
                    "uniforms": {
                      "accent": "#6366F1"
                    }
                  }
                },
                {
                  "id": "shader-card-caption",
                  "type": "text",
                  "content": "GLSL のソースと uniform を編集可能",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fontWeight": "400",
                  "fill": "#64748B"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
