                },
                {
                  "id": "activity-three",
                  "type": "text",
                  "content": "Noah completed the welcome flow.\n2 hours ago",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 14,
                  "fontWeight": "400",
                  "lineHeight": 1.5,
                  "fill": "$text",
                  "width": "fill_container",
                  "textGrowth": "fixed-width"
                }
              ],
              "fill": "$surface",
              "cornerRadius": 12,
              "padding": 24,
              "gap": 24,
              "width": 280,
              "height": "fill_container"
            }
          ],
          "width": "fill_container",
          "height": "fill_container",
          "gap": 24
        }
      ],
      "width": 1080,
      "height": 720,
      "padding": 24,
      "gap": 24,
      "fill": "$canvas"
