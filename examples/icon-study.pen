              "type": "frame",
              "width": 136,
              "height": 104,
              "layout": "vertical",
              "padding": 16,
              "gap": 8,
              "alignItems": "center",
              "justifyContent": "center",
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "id": "icon-user",
                  "type": "icon",
                  "library": "lucide",
                  "icon": "user",
                  "width": 32,
                  "height": 32,
                  "fill": "$ink"
                },
                {
                  "id": "label-user",
