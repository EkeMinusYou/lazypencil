                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fill": "$muted"
                }
              ]
            }
          ]
        },
        {
          "id": "effects",
          "type": "frame",
          "width": "fill_container",
          "height": 144,
          "layout": "horizontal",
          "gap": 16,
          "children": [
            {
              "id": "feature-gradient",
              "type": "frame",
              "width": 288,
              "height": 144,
              "layout": "vertical",
              "padding": 16,
              "gap": 8,
              "alignItems": "center",
              "justifyContent": "center",
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "id": "gradient",
                  "type": "icon",
                  "library": "lucide",
                  "icon": "circle",
                  "width": 64,
                  "height": 64,
                  "fill": {
                    "type": "gradient",
                    "gradientType": "linear",
                    "rotation": 90,
                    "colors": [
                      {
                        "color": "#F97316",
                        "position": 0
                      },
                      {
                        "color": "#2563EB",
                        "position": 1
                      }
                    ]
                  }
                },
                {
                  "id": "description-gradient",
                  "type": "text",
                  "content": "グラデーション",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fill": "$muted"
                }
              ]
            },
            {
              "id": "feature-fit",
              "type": "frame",
              "width": 288,
              "height": 144,
              "layout": "vertical",
              "padding": 16,
              "gap": 8,
              "alignItems": "center",
              "justifyContent": "center",
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "id": "fit",
                  "type": "icon",
                  "library": "lucide",
                  "icon": "circle",
                  "width": 104,
                  "height": 48,
                  "fill": "#2563EB"
                },
                {
                  "id": "description-fit",
                  "type": "text",
                  "content": "縦横比を保った配置",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fill": "$muted"
                }
              ]
            },
            {
              "id": "feature-alpha",
              "type": "frame",
              "width": 288,
              "height": 144,
              "layout": "vertical",
              "padding": 16,
              "gap": 8,
              "alignItems": "center",
              "justifyContent": "center",
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "id": "alpha",
                  "type": "icon",
                  "library": "lucide",
                  "icon": "plus",
                  "width": 64,
                  "height": 64,
                  "fill": "#2563EB80",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "offset": {
                      "x": 2,
                      "y": 4
                    },
                    "blur": 4,
                    "color": "#0F172A33"
                  }
                },
                {
                  "id": "description-alpha",
                  "type": "text",
                  "content": "半透明と影",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fill": "$muted"
                }
              ]
            }
          ]
        },
        {
          "id": "caption",
          "type": "text",
          "content": "固定版の Lucide を同梱 · 追加パックは明示的に導入 · 元の .pen を編集できます",
          "fontFamily": "Noto Sans JP",
          "fontSize": 12,
          "lineHeight": 1.5,
          "fill": "$muted"
        }
