{
  "version": "2.21",
  "variables": {
    "canvas": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "ink": {
      "type": "color",
      "value": "#0F172A"
    },
    "muted": {
      "type": "color",
      "value": "#475569"
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "name": "Pinned vector icon study",
      "width": 960,
      "height": 700,
      "layout": "vertical",
      "padding": 32,
      "gap": 18,
      "fill": "$canvas",
      "children": [
        {
          "id": "title",
          "type": "text",
          "content": "アイコンのデザイン",
          "fontFamily": "Noto Sans JP",
          "fontSize": 28,
          "fontWeight": "700",
          "lineHeight": 1.25,
          "fill": "$ink"
        },
        {
          "id": "subtitle",
          "type": "text",
          "content": "Lucide のベクターを、文字・余白・色のルールと組み合わせます。",
          "fontFamily": "Noto Sans JP",
          "fontSize": 14,
          "lineHeight": 1.5,
          "fill": "$muted"
        },
        {
          "id": "row-0",
          "type": "frame",
          "width": "fill_container",
          "height": 104,
          "layout": "horizontal",
          "gap": 16,
          "children": [
            {
              "id": "tile-search",
              "type": "frame",
              "width": 136,
              "height": 104,
              "layout": "vertical",
              "padding": 16,
              "gap": 8,
              "alignItems": "center",
              "justifyContent": "center",
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "id": "icon-search",
                  "type": "icon",
                  "library": "lucide",
                  "icon": "search",
                  "width": 32,
                  "height": 32,
                  "fill": "$ink"
                },
                {
                  "id": "label-search",
                  "type": "text",
                  "content": "検索",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fill": "$muted"
                }
              ]
            },
            {
              "id": "tile-house",
              "type": "frame",
              "width": 136,
              "height": 104,
              "layout": "vertical",
              "padding": 16,
              "gap": 8,
              "alignItems": "center",
              "justifyContent": "center",
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "id": "icon-house",
                  "type": "icon",
                  "library": "lucide",
                  "icon": "house",
                  "width": 32,
                  "height": 32,
                  "fill": "$ink"
                },
                {
                  "id": "label-house",
                  "type": "text",
                  "content": "ホーム",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
                  "fill": "$muted"
                }
              ]
            },
            {
              "id": "tile-settings",
              "type": "frame",
              "width": 136,
              "height": 104,
              "layout": "vertical",
              "padding": 16,
              "gap": 8,
              "alignItems": "center",
              "justifyContent": "center",
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "id": "icon-settings",
                  "type": "icon",
                  "library": "lucide",
                  "icon": "settings",
                  "width": 32,
                  "height": 32,
                  "fill": "$ink"
                },
                {
                  "id": "label-settings",
                  "type": "text",
                  "content": "設定",
                  "fontFamily": "Noto Sans JP",
                  "fontSize": 12,
