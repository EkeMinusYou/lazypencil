{
  "version": "1.0.0",
  "language": "en",
  "license": "MIT",
  "styles": [
    {
      "id": "standard-ui",
      "version": "1.0.2",
      "name": "Standard UI",
      "description": "A restrained, readable starting point for application screens.",
      "use_cases": [
        "app-screen",
        "forms",
        "settings"
      ],
      "guidance": [
        "start",
        "app-screen",
        "layout",
        "typography",
        "color",
        "components",
        "verification"
      ],
      "example": "standard-ui.pen",
      "tokens": {
        "fontFamily": "Noto Sans JP",
        "fontSizes": [
          32,
          24,
          20,
          16,
          14,
          12
        ],
        "fontWeights": [
          400,
          500,
          700
        ],
        "spacing": [
          4,
          8,
          12,
          16,
          24,
          32,
          48
        ],
        "colors": {
          "canvas": "#F8FAFC",
          "surface": "#FFFFFF",
          "text": "#0F172A",
          "secondary": "#475569",
          "border": "#CBD5E1",
          "accent": "#2563EB",
          "error": "#B91C1C"
        },
        "controlHeight": 44,
        "cardRadius": 12
      },
      "instructions": "Use clear hierarchy, a small spacing scale, and a single prominent primary action. Respect existing document conventions when editing. The example includes reusable button, button-with-icon, breadcrumbs, sort-control, text-avatar, and form-field definitions. Labels follow their layout roles; form messages grow with their content and can appear independently. Prefer existing components; import these fallbacks only when useful and adapt their tokens. Do not copy their stored IDs into an editing batch."
    },
    {
      "id": "dense-workspace",
      "version": "1.0.0",
      "name": "Dense workspace",
      "description": "Compact neutral surfaces for project lists, dashboards, and working interfaces.",
      "use_cases": [
        "dashboard",
        "workspace",
        "tables"
      ],
      "guidance": [
        "start",
        "dashboard",
        "layout",
        "typography",
        "components",
        "verification"
      ],
      "example": "dense-workspace.pen",
      "tokens": {
        "fontFamily": "Noto Sans JP",
        "fontSizes": [
          28,
          24,
          20,
          16,
          14,
          12
        ],
        "fontWeights": [
          400,
          500,
          700
        ],
        "spacing": [
          4,
          8,
          12,
          16,
          24,
          32
        ],
        "colors": {
          "canvas": "#F1F5F9",
          "surface": "#FFFFFF",
          "text": "#0F172A",
          "secondary": "#475569",
          "border": "#CBD5E1",
          "accent": "#2563EB"
        },
        "rowHeight": 56,
        "controlHeight": 40,
        "cardRadius": 12
      },
      "instructions": "Prioritize scan order, aligned columns, meaningful metric labels, and consistent status cues. Use restrained emphasis instead of assigning a strong color to every card. Replace sample data with the user's actual information."
    },
    {
      "id": "content-page",
      "version": "1.0.0",
      "name": "Content page",
      "description": "A spacious warm palette and reading hierarchy for editorial or introductory pages.",
      "use_cases": [
        "content-page",
