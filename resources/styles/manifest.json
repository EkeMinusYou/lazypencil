        "editorial"
      ],
      "guidance": [
        "start",
        "content-page",
        "typography",
        "color",
        "layout",
        "verification"
      ],
      "example": "content-page.pen",
      "tokens": {
        "fontFamily": "Noto Sans JP",
        "fontSizes": [
          48,
          32,
          24,
          20,
          18,
          16,
          14,
          12
        ],
        "fontWeights": [
          400,
          500,
          700
        ],
        "spacing": [
          8,
          12,
          16,
          24,
          32,
          40,
          64,
          80
        ],
        "colors": {
          "canvas": "#FFFCF7",
          "surface": "#FFFFFF",
          "text": "#292524",
          "secondary": "#57534E",
          "border": "#E7E5E4",
          "accent": "#92400E"
        },
        "controlHeight": 48,
        "cardRadius": 12
      },
      "instructions": "Lead with a clear message and a useful next action. Keep body copy readable, make supporting sections specific, and use imagery only when it adds meaning and has suitable usage rights. Adapt section structure to the content."
    }
  ]
}
